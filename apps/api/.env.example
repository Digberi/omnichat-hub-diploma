NODE_ENV=development
PORT=4121
# Redis/BullMQ/socket.io namespacing (prevents cross-env interference on shared Redis).
# If empty, defaults to:
# - BULLMQ_PREFIX=omnichat:<NODE_ENV>
# - SOCKETIO_REDIS_KEY=socket.io:<NODE_ENV>
BULLMQ_PREFIX=
SOCKETIO_REDIS_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnichat
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SEARCH_DEFAULT_DAYS=7
PUBLIC_WEB_URL=http://localhost:3000
SHORTLINK_TTL_DAYS=7
ATTACHMENT_TTL_DAYS=7
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=omnichat
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# Apply/ensure bucket lifecycle rule for attachments prefix ("attachments/") on API startup (best-effort).
# Set to 0 if lifecycle is managed by IaC/infra (recommended in production).
STORAGE_APPLY_LIFECYCLE=1
STORAGE_REQUEST_TIMEOUT_MS=5000
STORAGE_RETRY_ATTEMPTS=3
STORAGE_RETRY_DELAY_MS=100
# Storage alert thresholds for /v1/metrics/storage/health.
STORAGE_ALERT_PING_MAX_AGE_MS=120000
STORAGE_ALERT_FAILURE_RATE_WARN_PCT=5
STORAGE_ALERT_FAILURE_RATE_CRITICAL_PCT=20
STORAGE_ALERT_AVG_DURATION_WARN_MS=1500
STORAGE_ALERT_AVG_DURATION_CRITICAL_MS=4000
JWT_ACCESS_SECRET=change_me_please_change_me_please_change_me
JWT_REFRESH_SECRET=change_me_please_change_me_please_change_me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
AUTH_OTP_PEPPER=change_me_please_change_me_please_change_me
AUTH_OTP_TTL_MIN=10
AUTH_OTP_MAX_ATTEMPTS=5
# Dev/E2E convenience: fixed OTP code (NOT allowed in production)
AUTH_OTP_FIXED_CODE=000000
EMAIL_PROVIDER=console
# Example: OmniChat <hello@omnichat.to>
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
# ---- Infisical KMS (envelope encryption for channel tokens) ----------
# Provisioned via Pulumi. Required for token encrypt/decrypt at runtime.
# Universal Auth client credentials (Machine Identity → Universal Auth in Infisical UI).
INFISICAL_KMS_BASE_URL=https://app.infisical.com/api/v1
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_KMS_KEY_ID=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
METRICS_TOKEN=change_me_change_me_change_me
LOKI_HOST=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_BATCH_INTERVAL_SEC=5
LOKI_BATCH_MAX_BUFFER=10000
# OLX OAuth (optional; disabled if empty)
OLX_BASE_URL=https://apps.olx.com.br
OLX_AUTH_URL=https://auth.olx.com.br/oauth
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_REDIRECT_URL=http://localhost:4121/v1/channel-accounts/olx/callback
OLX_SCOPE=autoupload chat
OLX_TOKEN_ENDPOINT=https://auth.olx.com.br/oauth/token
OLX_BASIC_USER_INFO_ENDPOINT=https://apps.olx.com.br/oauth_api/basic_user_info
OLX_SEND_MESSAGE_ENDPOINT=https://apps.olx.com.br/autoservice/v1/chat/send
OLX_REQUEST_TIMEOUT_MS=10000
# Google OAuth (optional; disabled if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4121/v1/auth/google/callback
