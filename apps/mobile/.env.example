# Leave these blank for local dev to auto-detect your Metro host IP and use :4121.
# If you run on a physical device, you can also set these explicitly to your machine LAN IP (e.g. http://192.168.0.10:4121).
# For Android emulator you can use: http://10.0.2.2:4121
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_WS_URL=
EXPO_PUBLIC_WS_PATH=/ws
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_SENTRY_RELEASE=
