NODE_ENV=development
WORKERS_PORT=4122
# Redis/BullMQ/socket.io namespacing (prevents cross-env interference on shared Redis).
# If empty, defaults to:
# - BULLMQ_PREFIX=omnichat:<NODE_ENV>
# - SOCKETIO_REDIS_KEY=socket.io:<NODE_ENV>
BULLMQ_PREFIX=
SOCKETIO_REDIS_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnichat
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_SEC=60
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_TTL_SEC=300
MAINTENANCE_INTERVAL_SEC=60
METRICS_ROLLUP_INTERVAL_SEC=3600

# channel sync (stub; optional)
CHANNEL_SYNC_STUB_ENABLED=true
CHANNEL_SYNC_INTERVAL_SEC=60
CHANNEL_SYNC_STUB_MAX_ACCOUNTS=3

# channel sync (OLX; optional)
# channel sync (OLX UA; optional)
CHANNEL_SYNC_OLX_ENABLED=false
CHANNEL_SYNC_OLX_MAX_ACCOUNTS=50
CHANNEL_SYNC_OLX_LIMIT=100
OLX_BASE_URL=https://www.olx.ua
OLX_REQUEST_TIMEOUT_MS=10000

# channel sync (Rozetka chats; optional)
CHANNEL_SYNC_ROZETKA_ENABLED=false
CHANNEL_SYNC_ROZETKA_MAX_ACCOUNTS=50
ROZETKA_REQUEST_TIMEOUT_MS=8000

# channel sync (Rozetka orders → inbox messages; optional)
CHANNEL_SYNC_ROZETKA_ORDERS_ENABLED=false
CHANNEL_SYNC_ROZETKA_ORDERS_LIMIT=50

# ---- Infisical KMS (envelope encryption for channel tokens) ----------
# Provisioned via Pulumi. Required for token encrypt/decrypt at runtime.
# Universal Auth client credentials (Machine Identity → Universal Auth in Infisical UI).
INFISICAL_KMS_BASE_URL=https://app.infisical.com/api/v1
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_KMS_KEY_ID=

# push (optional)
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

ATTACHMENT_TTL_DAYS=7
STORAGE_REQUEST_TIMEOUT_MS=5000
STORAGE_RETRY_ATTEMPTS=3
STORAGE_RETRY_DELAY_MS=100

# storage (optional; defaults are MinIO local dev)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=omnichat
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_OUTBOX_BACKLOG_WARN=200
SENTRY_OUTBOX_BACKLOG_COOLDOWN_SEC=300
METRICS_TOKEN=change_me_change_me_change_me
LOKI_HOST=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_BATCH_INTERVAL_SEC=5
LOKI_BATCH_MAX_BUFFER=10000
