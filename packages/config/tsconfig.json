{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../..//tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.{ts,tsx,js,cjs,mjs}"]
}
