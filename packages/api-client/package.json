{
  "name": "@omnichat/api-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node ./scripts/generate.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@omnichat/observability": "workspace:*",
    "openapi-fetch": "^0.17.0"
  }
}
