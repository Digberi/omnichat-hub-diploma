    "@opentelemetry/sdk-trace-web": {
      "optional": true
    },
    "@opentelemetry/auto-instrumentations-node": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-logs-otlp-http": {
      "optional": true
    },
    "@opentelemetry/instrumentation-fetch": {
      "optional": true
    },
    "@opentelemetry/instrumentation-document-load": {
      "optional": true
    },
    "@opentelemetry/instrumentation-user-interaction": {
      "optional": true
    },
    "@vercel/otel": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    },
    "@sentry/browser": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "pino-opentelemetry-transport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/context-zone": "^1.30.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation": "^0.57.0",
    "@opentelemetry/instrumentation-document-load": "^0.40.0",
    "@opentelemetry/instrumentation-fetch": "^0.57.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.40.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-logs": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-web": "^1.30.0",
    "@types/node": "^22.16.5",
    "@vercel/otel": "^1.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "rxjs": "^7.8.0",
    "tsup": "^8.3.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0"
  }
