{
  "name": "@omnichat/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./src/core/index.ts",
  "typesVersions": {
    "*": {
      "node": [
        "./src/node/index.ts"
      ],
      "vercel": [
        "./src/vercel/index.ts"
      ],
      "browser": [
        "./src/browser/index.ts"
      ],
      "expo": [
        "./src/expo/index.ts"
      ],
      "workers": [
        "./src/workers/index.ts"
      ],
      "nest": [
        "./src/nest/index.ts"
      ],
      "testing/no-op": [
        "./src/testing/no-op.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    },
    "./vercel": {
      "import": {
        "types": "./dist/vercel/index.d.ts",
        "default": "./dist/vercel/index.js"
      },
      "require": {
        "types": "./dist/vercel/index.d.cts",
        "default": "./dist/vercel/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "require": {
        "types": "./dist/browser/index.d.cts",
        "default": "./dist/browser/index.cjs"
      }
    },
    "./expo": {
      "import": {
        "types": "./dist/expo/index.d.ts",
        "default": "./dist/expo/index.js"
      },
      "require": {
        "types": "./dist/expo/index.d.cts",
        "default": "./dist/expo/index.cjs"
      }
    },
    "./workers": {
      "import": {
        "types": "./dist/workers/index.d.ts",
        "default": "./dist/workers/index.js"
      },
      "require": {
        "types": "./dist/workers/index.d.cts",
        "default": "./dist/workers/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/nest/index.d.cts",
        "default": "./dist/nest/index.cjs"
      }
    },
    "./testing/no-op": {
      "import": {
        "types": "./dist/testing/no-op.d.ts",
        "default": "./dist/testing/no-op.js"
      },
      "require": {
        "types": "./dist/testing/no-op.d.cts",
        "default": "./dist/testing/no-op.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
