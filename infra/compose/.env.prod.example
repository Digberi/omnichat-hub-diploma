# Shared
NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/omnichat
REDIS_URL=redis://redis:6379
BULLMQ_PREFIX=omnichat:production
SOCKETIO_REDIS_KEY=socket.io:production

# API
API_PORT=4121
API_CORS_ORIGINS=https://app.example.com
API_PUBLIC_WEB_URL=https://app.example.com
API_LOG_LEVEL=info
API_SEARCH_DEFAULT_DAYS=7
API_SHORTLINK_TTL_DAYS=7
API_ATTACHMENT_TTL_DAYS=7
API_STORAGE_ENDPOINT=http://minio:9000
API_STORAGE_REGION=us-east-1
API_STORAGE_BUCKET=omnichat
API_STORAGE_ACCESS_KEY=minioadmin
API_STORAGE_SECRET_KEY=minioadmin
API_STORAGE_APPLY_LIFECYCLE=0
API_STORAGE_REQUEST_TIMEOUT_MS=5000
API_STORAGE_RETRY_ATTEMPTS=3
API_STORAGE_RETRY_DELAY_MS=100
API_STORAGE_ALERT_PING_MAX_AGE_MS=120000
API_STORAGE_ALERT_FAILURE_RATE_WARN_PCT=5
API_STORAGE_ALERT_FAILURE_RATE_CRITICAL_PCT=20
API_STORAGE_ALERT_AVG_DURATION_WARN_MS=1500
API_STORAGE_ALERT_AVG_DURATION_CRITICAL_MS=4000
API_JWT_ACCESS_SECRET=change_me_change_me_change_me_change_me
API_JWT_REFRESH_SECRET=change_me_change_me_change_me_change_me
API_AUTH_OTP_PEPPER=change_me_change_me_change_me_change_me
API_JWT_ACCESS_TTL_MIN=15
API_JWT_REFRESH_TTL_DAYS=30
API_AUTH_OTP_TTL_MIN=10
API_AUTH_OTP_MAX_ATTEMPTS=5
API_AUTH_OTP_FIXED_CODE=
API_GOOGLE_CLIENT_ID=
API_GOOGLE_CLIENT_SECRET=
API_GOOGLE_CALLBACK_URL=https://api.example.com/v1/auth/google/callback
API_SENTRY_DSN=
API_SENTRY_TRACES_SAMPLE_RATE=0.05
API_SENTRY_ENVIRONMENT=production
API_SENTRY_RELEASE=
API_METRICS_TOKEN=change_me_change_me_change_me
API_LOKI_HOST=
API_LOKI_USERNAME=
API_LOKI_PASSWORD=
API_LOKI_BATCH_INTERVAL_SEC=5
API_LOKI_BATCH_MAX_BUFFER=10000

# Workers
WORKERS_PORT=4122
WORKERS_LOG_LEVEL=info
WORKERS_OUTBOX_POLL_INTERVAL_SEC=60
WORKERS_OUTBOX_MAX_ATTEMPTS=10
WORKERS_OUTBOX_LOCK_TTL_SEC=300
WORKERS_MAINTENANCE_INTERVAL_SEC=60
WORKERS_METRICS_ROLLUP_INTERVAL_SEC=3600
WORKERS_CHANNEL_SYNC_STUB_ENABLED=false
WORKERS_CHANNEL_SYNC_INTERVAL_SEC=60
WORKERS_CHANNEL_SYNC_STUB_MAX_ACCOUNTS=3
WORKERS_PUSH_PROVIDER=expo
WORKERS_EXPO_ACCESS_TOKEN=
WORKERS_ATTACHMENT_TTL_DAYS=7
WORKERS_STORAGE_ENDPOINT=http://minio:9000
WORKERS_STORAGE_REGION=us-east-1
WORKERS_STORAGE_BUCKET=omnichat
WORKERS_STORAGE_ACCESS_KEY=minioadmin
WORKERS_STORAGE_SECRET_KEY=minioadmin
WORKERS_STORAGE_REQUEST_TIMEOUT_MS=5000
WORKERS_STORAGE_RETRY_ATTEMPTS=3
WORKERS_STORAGE_RETRY_DELAY_MS=100
WORKERS_SENTRY_DSN=
WORKERS_SENTRY_TRACES_SAMPLE_RATE=0.05
WORKERS_SENTRY_ENVIRONMENT=production
WORKERS_SENTRY_RELEASE=
WORKERS_SENTRY_OUTBOX_BACKLOG_WARN=200
WORKERS_SENTRY_OUTBOX_BACKLOG_COOLDOWN_SEC=300
WORKERS_METRICS_TOKEN=change_me_change_me_change_me
WORKERS_LOKI_HOST=
WORKERS_LOKI_USERNAME=
WORKERS_LOKI_PASSWORD=
WORKERS_LOKI_BATCH_INTERVAL_SEC=5
WORKERS_LOKI_BATCH_MAX_BUFFER=10000

# Web build/runtime
WEB_PORT=3000
WEB_NEXT_PUBLIC_API_BASE_URL=https://api.example.com
WEB_NEXT_PUBLIC_WS_URL=https://api.example.com
WEB_NEXT_PUBLIC_WS_PATH=/ws
WEB_NEXT_PUBLIC_DEFAULT_LOCALE=uk
WEB_NEXT_PUBLIC_SENTRY_DSN=
WEB_NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
WEB_NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
WEB_NEXT_PUBLIC_SENTRY_RELEASE=
WEB_SENTRY_DSN=
WEB_SENTRY_TRACES_SAMPLE_RATE=0.05
WEB_SENTRY_ENVIRONMENT=production
WEB_SENTRY_RELEASE=
WEB_SENTRY_ORG=
WEB_SENTRY_PROJECT=omnichat-web
WEB_SENTRY_AUTH_TOKEN=
WEB_SENTRY_URL=https://sentry.io/

# Infra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omnichat
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
